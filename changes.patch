diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/phone_notif_service.dart b/lib/jobs/radar/phone_notif_service.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/phone_notif_service.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/phone_notif_service.dart	2026-10-13 14:56:14.472616159 +0000
@@ -0,0 +1,157 @@
+import 'dart:convert';
+import 'package:flutter/services.dart';
+import '../../services/settings_service.dart';
+import 'radar_service.dart';
+
+/// ফোনে ইনস্টল করা চাকরির অ্যাপের নোটিফিকেশন থেকে ধরা এন্ট্রি।
+class PhoneAlert {
+  final String pkg;
+  final String title;
+  final String text;
+  final DateTime time;
+  final bool match; // টার্গেট পদের কীওয়ার্ড মিলেছে কি না
+
+  PhoneAlert({required this.pkg, required this.title, required this.text, required this.time, required this.match});
+
+  String get key => '$pkg|$title|$text';
+
+  Map<String, dynamic> toMap() => {
+        'pkg': pkg, 'title': title, 'text': text, 'time': time.millisecondsSinceEpoch, 'match': match,
+      };
+
+  factory PhoneAlert.fromMap(Map<String, dynamic> m) => PhoneAlert(
+        pkg: (m['pkg'] as String?) ?? '',
+        title: (m['title'] as String?) ?? '',
+        text: (m['text'] as String?) ?? '',
+        time: DateTime.fromMillisecondsSinceEpoch((m['time'] as num?)?.toInt() ?? 0),
+        match: (m['match'] as bool?) ?? false,
+      );
+
+  /// ব্রাউজারে খোঁজার লিংক (স্বয়ংক্রিয় ওয়েব-অনুসন্ধান রাডারের কাজ; এটা হাতে দেখার শর্টকাট)।
+  String get searchUrl =>
+      'https://www.google.com/search?q=${Uri.encodeQueryComponent('${title.isEmpty ? text : title} নিয়োগ বিজ্ঞপ্তি')}';
+}
+
+class AppInfo {
+  final String label;
+  final String pkg;
+  AppInfo(this.label, this.pkg);
+}
+
+/// Kotlin NotificationListenerService-এর সাথে সংযোগ। শুধু ব্যবহারকারীর বেছে দেওয়া অ্যাপ।
+class PhoneNotifService {
+  static const _ch = MethodChannel('com.hanif.mymanager/jobnotif');
+  static const _kAlerts = 'radar_phone_alerts';
+  static const _maxAlerts = 100;
+
+  static Future<bool> isEnabled() async {
+    try {
+      return (await _ch.invokeMethod<bool>('isEnabled')) ?? false;
+    } catch (_) {
+      return false;
+    }
+  }
+
+  static Future<void> openSettings() async {
+    try {
+      await _ch.invokeMethod('openSettings');
+    } catch (_) {}
+  }
+
+  static Future<List<String>> packages() async {
+    try {
+      final r = await _ch.invokeMethod<List<dynamic>>('getPackages');
+      return (r ?? const []).map((e) => e.toString()).toList()..sort();
+    } catch (_) {
+      return [];
+    }
+  }
+
+  static Future<void> setPackages(List<String> pkgs) async {
+    try {
+      await _ch.invokeMethod('setPackages', {'packages': pkgs});
+    } catch (_) {}
+  }
+
+  static Future<List<AppInfo>> searchApps(String q) async {
+    try {
+      final r = await _ch.invokeMethod<List<dynamic>>('searchApps', {'query': q});
+      return (r ?? const [])
+          .map((e) => Map<String, dynamic>.from(e as Map))
+          .map((m) => AppInfo((m['label'] ?? '').toString(), (m['pkg'] ?? '').toString()))
+          .toList();
+    } catch (_) {
+      return [];
+    }
+  }
+
+  static bool _matches(String s) =>
+      RadarService.keywords.any((k) => RegExp(k, caseSensitive: false).hasMatch(s));
+
+  static List<PhoneAlert> alerts() {
+    final raw = SettingsService.getString(_kAlerts);
+    if (raw.isEmpty) return [];
+    try {
+      final list = (jsonDecode(raw) as List)
+          .map((e) => PhoneAlert.fromMap(Map<String, dynamic>.from(e as Map)))
+          .toList();
+      list.sort((a, b) {
+        if (a.match != b.match) return a.match ? -1 : 1;
+        return b.time.compareTo(a.time);
+      });
+      return list;
+    } catch (_) {
+      return [];
+    }
+  }
+
+  static Future<void> _save(List<PhoneAlert> l) async {
+    final keep = l.length > _maxAlerts ? l.sublist(l.length - _maxAlerts) : l;
+    await SettingsService.setString(_kAlerts, jsonEncode(keep.map((e) => e.toMap()).toList()));
+  }
+
+  /// নেটিভ কিউ থেকে নতুন নোটিফিকেশন এনে জমা করে। নতুন যোগ হওয়ার সংখ্যা ফেরত দেয়।
+  static Future<int> sync() async {
+    String raw;
+    try {
+      raw = (await _ch.invokeMethod<String>('drain')) ?? '[]';
+    } catch (_) {
+      return 0;
+    }
+    List<dynamic> incoming;
+    try {
+      incoming = jsonDecode(raw) as List<dynamic>;
+    } catch (_) {
+      return 0;
+    }
+    if (incoming.isEmpty) return 0;
+    final cur = alerts();
+    final keys = cur.map((e) => e.key).toSet();
+    var added = 0;
+    for (final e in incoming) {
+      final m = Map<String, dynamic>.from(e as Map);
+      final title = (m['title'] ?? '').toString();
+      final text = (m['text'] ?? '').toString();
+      final a = PhoneAlert(
+        pkg: (m['pkg'] ?? '').toString(),
+        title: title,
+        text: text,
+        time: DateTime.fromMillisecondsSinceEpoch((m['time'] as num?)?.toInt() ?? DateTime.now().millisecondsSinceEpoch),
+        match: _matches('$title\n$text'),
+      );
+      if (keys.add(a.key)) {
+        cur.add(a);
+        added++;
+      }
+    }
+    await _save(cur);
+    return added;
+  }
+
+  static Future<void> remove(String key) async {
+    final cur = alerts()..removeWhere((e) => e.key == key);
+    await _save(cur);
+  }
+
+  static Future<void> clear() => SettingsService.setString(_kAlerts, '[]');
+}
diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/radar_models.dart b/lib/jobs/radar/radar_models.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/radar_models.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/radar_models.dart	2026-10-20 19:30:07.717774787 +0000
@@ -0,0 +1,121 @@
+import '../../reminder/models/reminder.dart' show Reminder, dateOnly;
+
+/// Job Radar-এর ফলাফলের মডেল (ইঞ্জিন → ক্যাশ → UI)।
+class RadarCheck {
+  final String key;
+  final String s; // ok | warn | fail
+  final String msg;
+  const RadarCheck({required this.key, required this.s, required this.msg});
+
+  factory RadarCheck.fromMap(Map<String, dynamic> m) => RadarCheck(
+        key: (m['key'] as String?) ?? '',
+        s: (m['s'] as String?) ?? 'warn',
+        msg: (m['msg'] as String?) ?? '',
+      );
+
+  Map<String, dynamic> toMap() => {'key': key, 's': s, 'msg': msg};
+
+  String get icon => s == 'ok' ? '✅' : (s == 'fail' ? '❌' : '⚠️');
+}
+
+class RadarPost {
+  final String title;
+  final int? count;
+  final String verdict; // ok | warn | fail
+  final List<RadarCheck> checks;
+  const RadarPost({required this.title, this.count, required this.verdict, required this.checks});
+
+  factory RadarPost.fromMap(Map<String, dynamic> m) => RadarPost(
+        title: (m['title'] as String?) ?? '',
+        count: (m['count'] as num?)?.toInt(),
+        verdict: (m['verdict'] as String?) ?? 'warn',
+        checks: ((m['checks'] as List?) ?? const [])
+            .map((e) => RadarCheck.fromMap(Map<String, dynamic>.from(e as Map)))
+            .toList(),
+      );
+
+  Map<String, dynamic> toMap() => {
+        'title': title,
+        'count': count,
+        'verdict': verdict,
+        'checks': checks.map((c) => c.toMap()).toList(),
+      };
+}
+
+class RadarItem {
+  final String url;
+  final String title;
+  final String verdict; // ok | warn
+  final String org;
+  final DateTime? deadline; // স্থানীয় মধ্যরাত
+  final String method;
+  final String fee;
+  final List<RadarPost> posts;
+
+  const RadarItem({
+    required this.url,
+    required this.title,
+    required this.verdict,
+    this.org = '',
+    this.deadline,
+    this.method = '',
+    this.fee = '',
+    this.posts = const [],
+  });
+
+  factory RadarItem.fromMap(Map<String, dynamic> m) {
+    final d = m['deadline'] as String?;
+    return RadarItem(
+      url: (m['url'] as String?) ?? '',
+      title: (m['title'] as String?) ?? '',
+      verdict: (m['verdict'] as String?) ?? 'warn',
+      org: (m['org'] as String?) ?? '',
+      deadline: (d == null || d.length < 10) ? null : Reminder.parseYmd(d.substring(0, 10)),
+      method: (m['method'] as String?) ?? '',
+      fee: (m['fee'] as String?) ?? '',
+      posts: ((m['posts'] as List?) ?? const [])
+          .map((e) => RadarPost.fromMap(Map<String, dynamic>.from(e as Map)))
+          .toList(),
+    );
+  }
+
+  Map<String, dynamic> toMap() => {
+        'url': url,
+        'title': title,
+        'verdict': verdict,
+        'org': org,
+        'deadline': deadline == null ? null : Reminder.ymd(deadline!),
+        'method': method,
+        'fee': fee,
+        'posts': posts.map((p) => p.toMap()).toList(),
+      };
+
+  /// আজকের হিসাবে বাকি দিন (সংরক্ষিত সংখ্যা পুরনো হয়ে যায়, তাই প্রতিবার নিজে হিসাব)।
+  int? get daysLeft =>
+      deadline == null ? null : dateOnly(deadline!).difference(dateOnly(DateTime.now())).inDays;
+}
+
+class RadarFeed {
+  final DateTime? generatedAt;
+  final List<RadarItem> items;
+  /// শেষ রিপোর্টের পর যেগুলো প্রথমবার পাওয়া গেছে।
+  final List<String> newUrls;
+  const RadarFeed({this.generatedAt, required this.items, this.newUrls = const []});
+
+  factory RadarFeed.fromMap(Map<String, dynamic> m) {
+    final g = m['generatedAt'] as String?;
+    return RadarFeed(
+      generatedAt: g == null ? null : DateTime.tryParse(g)?.toLocal(),
+      items: ((m['items'] as List?) ?? const [])
+          .map((e) => RadarItem.fromMap(Map<String, dynamic>.from(e as Map)))
+          .toList(),
+      newUrls: ((m['newUrls'] as List?) ?? const []).map((e) => e.toString()).toList(),
+    );
+  }
+
+  Map<String, dynamic> toMap() => {
+        'generatedAt': generatedAt?.toUtc().toIso8601String(),
+        'items': items.map((i) => i.toMap()).toList(),
+        'newUrls': newUrls,
+      };
+}
diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/radar_runner.dart b/lib/jobs/radar/radar_runner.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/radar_runner.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/radar_runner.dart	2026-10-21 09:03:10.304377770 +0000
@@ -0,0 +1,230 @@
+import 'dart:convert';
+import '../../reminder/models/reminder.dart' show Reminder;
+import '../../services/notification_service.dart';
+import '../../services/settings_service.dart';
+import 'engine/bdgovtjob_source.dart';
+import 'engine/bn_util.dart';
+import 'engine/match_engine.dart';
+import 'engine/teletalk_radar.dart';
+import 'engine/teletalk_source.dart';
+import 'radar_models.dart';
+import 'radar_service.dart';
+
+class RadarRunSummary {
+  final int total; // তালিকায় মোট চলমান উপযুক্ত
+  final int ok;
+  final int warn;
+  final int fresh; // নতুন
+  final String? error;
+  const RadarRunSummary({this.total = 0, this.ok = 0, this.warn = 0, this.fresh = 0, this.error});
+}
+
+/// রাডার চালায়: সাইট থেকে পড়া → যাচাই → ক্যাশ → (রাতে) একটাই নোটিফিকেশন।
+/// অ্যাপ খোলা অবস্থায় ও ব্যাকগ্রাউন্ড টাস্ক — দুই জায়গা থেকেই চলে।
+class RadarRunner {
+  static const _kState = 'radar_runner_state';
+  static const _kRunning = 'radar_running_at';
+  static const _maxFetch = 25;
+  static const _engineVersion = 3; // যাচাই-নিয়ম বদলালে বাড়াই — পুরনো ফলাফল আবার যাচাই হবে
+
+  static String _today() => Reminder.ymd(DateTime.now());
+
+  static Map<String, dynamic> _loadState() {
+    final raw = SettingsService.getString(_kState);
+    if (raw.isEmpty) return {'items': <String, dynamic>{}, 'lastReport': '', 'reported': <dynamic>[]};
+    try {
+      return Map<String, dynamic>.from(jsonDecode(raw) as Map);
+    } catch (_) {
+      return {'items': <String, dynamic>{}, 'lastReport': '', 'reported': <dynamic>[]};
+    }
+  }
+
+  /// আজকের রিপোর্ট বাকি আছে এবং রিপোর্টের সময় পেরিয়েছে কি না।
+  static bool isDue([DateTime? now]) {
+    if (!RadarService.dailyOn) return false;
+    final n = now ?? DateTime.now();
+    final at = DateTime(n.year, n.month, n.day, RadarService.reportHour, RadarService.reportMinute);
+    if (n.isBefore(at)) return false;
+    return _loadState()['lastReport'] != _today();
+  }
+
+  /// প্রোফাইল বদলালে: সব সংরক্ষিত ফলাফল "পুরনো" চিহ্নিত — পরের রানে নতুন প্রোফাইলে আবার যাচাই হবে।
+  static Future<void> markStale() async {
+    final s = _loadState();
+    final items = Map<String, dynamic>.from((s['items'] as Map?) ?? {});
+    for (final k in items.keys.toList()) {
+      final v = Map<String, dynamic>.from(items[k] as Map);
+      v['modified'] = null;
+      v['checkedAt'] = 0;
+      items[k] = v;
+    }
+    s['items'] = items;
+    await SettingsService.setString(_kState, jsonEncode(s));
+  }
+
+  /// সময় হলে চালিয়ে নোটিফিকেশন দেয়। ব্যাকগ্রাউন্ড টাস্ক ও অ্যাপ চালু — দুই জায়গা থেকেই ডাকা হয়।
+  static Future<RadarRunSummary?> runIfDue() async {
+    await RadarService.reload();
+    if (!isDue()) return null;
+    return run(report: true);
+  }
+
+  /// এখনই চালায়। [report] সত্য হলে রাতের নোটিফিকেশন দেয় ও "আজকের রিপোর্ট হয়ে গেছে" চিহ্নিত করে।
+  static Future<RadarRunSummary> run({bool report = false}) async {
+    final now = DateTime.now().millisecondsSinceEpoch;
+    final running = SettingsService.getInt(_kRunning);
+    if (running != 0 && now - running < 10 * 60 * 1000) {
+      return const RadarRunSummary(error: 'আরেকটা রান চলছে — একটু পরে দেখো');
+    }
+    await SettingsService.setInt(_kRunning, now);
+    try {
+      return await _run(report);
+    } finally {
+      await SettingsService.setInt(_kRunning, 0);
+    }
+  }
+
+  static Future<RadarRunSummary> _run(bool report) async {
+    final profile = RadarService.profile();
+    final state = _loadState();
+    final items = Map<String, dynamic>.from((state['items'] as Map?) ?? {});
+    final nowMs = DateTime.now().millisecondsSinceEpoch;
+    if (state['v'] != _engineVersion) {
+      // নিয়ম বদলেছে: সব এন্ট্রি "পুরনো" চিহ্নিত — এই রানেই নতুন নিয়মে আবার যাচাই হবে
+      for (final k in items.keys.toList()) {
+        final v = Map<String, dynamic>.from(items[k] as Map);
+        v['modified'] = null;
+        v['checkedAt'] = 0;
+        items[k] = v;
+      }
+      state['v'] = _engineVersion;
+    }
+
+    List<ListedPost> list;
+    try {
+      list = await listLatest(limit: 40);
+    } catch (e) {
+      list = [];
+    }
+    var fetched = 0;
+    for (final it in list) {
+      final prev = items[it.url] as Map?;
+      if (prev != null) {
+        if (it.modified != null && prev['modified'] == it.modified) continue;
+        if (it.modified == null && nowMs - ((prev['checkedAt'] as num?)?.toInt() ?? 0) < 6 * 3600 * 1000) continue;
+      }
+      if (fetched >= _maxFetch) break;
+      fetched++;
+      await Future<void>.delayed(const Duration(milliseconds: 800));
+      FetchedDetail d;
+      try {
+        d = await fetchDetail(it.url);
+      } catch (_) {
+        continue;
+      }
+      final title = it.title.isNotEmpty ? it.title : d.title;
+      final r = evaluate(d.text, profile, title: title);
+      final good = (r.verdict == 'ok' || r.verdict == 'warn') && !r.expired;
+      items[it.url] = {
+        'modified': it.modified,
+        'checkedAt': nowMs,
+        'item': good
+            ? RadarItem(
+                url: it.url,
+                title: title,
+                verdict: r.verdict,
+                org: r.org,
+                deadline: r.nearest == null ? null : DateTime(r.nearest!.year, r.nearest!.month, r.nearest!.day),
+                method: r.method,
+                fee: r.fee,
+                posts: r.posts.where((p) => p.verdict != 'fail').toList(),
+              ).toMap()
+            : null,
+      };
+    }
+
+    // ── Teletalk (সরাসরি সরকারি উৎস) ──
+    var teletalkOk = true;
+    try {
+      final tj = await fetchTeletalkJobs();
+      await RadarService.saveTeletalkAll(tj);
+      // আগের Teletalk এন্ট্রি মুছে নতুন তালিকা বসাই (পদ সরে গেলে/শেষ হলে ঠিক থাকে)
+      items.removeWhere((k, _) => k.toString().startsWith('teletalk:'));
+      // শুধু আমাদের টার্গেট পদগুলোর বিস্তারিত আনি (সাধারণত অল্প ক'টা) — বয়সসীমা যাচাইয়ের জন্য
+      final details = <int, TeletalkDetail>{};
+      for (final t in pickTeletalkTargets(tj, profile)) {
+        try {
+          details[t.primaryId] = await fetchTeletalkDetail(t.primaryId);
+        } catch (_) {}
+        await Future<void>.delayed(const Duration(milliseconds: 400));
+      }
+      for (final ri in teletalkItems(tj, profile, details: details)) {
+        items['teletalk:${ri.url}'] = {'modified': null, 'checkedAt': nowMs, 'item': ri.toMap()};
+      }
+    } catch (_) {
+      teletalkOk = false;
+    }
+    if (list.isEmpty && !teletalkOk) {
+      // দুটো উৎসই ব্যর্থ — আগের ক্যাশ যেমন আছে থাকুক; রিপোর্ট চিহ্নিত হবে না, পরের ঘণ্টায় আবার চেষ্টা।
+      return const RadarRunSummary(error: 'সাইট থেকে তালিকা পাওয়া যায়নি — ইন্টারনেট/সাইট দেখো');
+    }
+
+    // ১২০ দিনের পুরনো এন্ট্রি ছাঁটাই
+    items.removeWhere((_, v) => nowMs - (((v as Map)['checkedAt'] as num?)?.toInt() ?? 0) > 120 * 86400000);
+
+    // ফিড: চলমান, উপযুক্ত — শেষ তারিখ অনুযায়ী
+    final feedItems = <RadarItem>[];
+    for (final v in items.values) {
+      final m = (v as Map)['item'];
+      if (m == null) continue;
+      final ri = RadarItem.fromMap(Map<String, dynamic>.from(m as Map));
+      if (ri.daysLeft != null && ri.daysLeft! < 0) continue;
+      feedItems.add(ri);
+    }
+    feedItems.sort((a, b) => (a.daysLeft ?? 999).compareTo(b.daysLeft ?? 999));
+
+    final reported = ((state['reported'] as List?) ?? const []).map((e) => e.toString()).toSet();
+    final fresh = feedItems.where((i) => !reported.contains(i.url)).map((i) => i.url).toList();
+
+    final feed = RadarFeed(generatedAt: DateTime.now(), items: feedItems, newUrls: fresh);
+    await RadarService.saveFeed(feed);
+
+    state['items'] = items;
+    if (report) {
+      await _notify(feed);
+      state['lastReport'] = _today();
+      state['reported'] = feedItems.map((i) => i.url).toList(); // এখনকার সবই "জানানো" হলো
+    }
+    await SettingsService.setString(_kState, jsonEncode(state));
+
+    final ok = feedItems.where((i) => i.verdict == 'ok').length;
+    return RadarRunSummary(total: feedItems.length, ok: ok, warn: feedItems.length - ok, fresh: fresh.length);
+  }
+
+  // ── রাতের নোটিফিকেশন: একটাই, পুরো তালিকাসহ ──
+  static Future<void> _notify(RadarFeed feed) async {
+    final its = feed.items;
+    if (its.isEmpty) {
+      await NotificationService.showRadarReport(
+        '📡 আজকের রাডার',
+        'আজ তোমার যোগ্যতার সাথে মেলে এমন চলমান সার্কুলার নেই।',
+        'আজ তোমার যোগ্যতার সাথে মেলে এমন চলমান সার্কুলার নেই। কাল আবার দেখব।',
+      );
+      return;
+    }
+    final ok = its.where((i) => i.verdict == 'ok').length;
+    final warn = its.length - ok;
+    final fresh = feed.newUrls.toSet();
+    final head = '📡 আজকের রাডার: ${toBnStr(its.length)}টি সার্কুলার'
+        '${fresh.isNotEmpty ? ' (🆕 ${toBnStr(fresh.length)}টি নতুন)' : ''}';
+    final short = '🟢 ${toBnStr(ok)}টি সম্ভাব্য যোগ্য · 🟡 ${toBnStr(warn)}টি যাচাই বাকি';
+    final lines = <String>[];
+    for (final i in its.take(10)) {
+      final dl = i.daysLeft;
+      final when = dl == null ? '' : (dl == 0 ? ' — আজই শেষ' : ' — আর ${toBnStr(dl)} দিন');
+      lines.add('${fresh.contains(i.url) ? '🆕' : (i.verdict == 'ok' ? '🟢' : '🟡')} ${i.title}$when');
+    }
+    if (its.length > 10) lines.add('… আরও ${toBnStr(its.length - 10)}টি — অ্যাপে দেখো');
+    await NotificationService.showRadarReport(head, short, '$short\n\n${lines.join('\n')}');
+  }
+}
diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/radar_service.dart b/lib/jobs/radar/radar_service.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/radar_service.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/radar_service.dart	2026-10-21 08:50:24.484157364 +0000
@@ -0,0 +1,193 @@
+import 'dart:convert';
+import 'package:shared_preferences/shared_preferences.dart';
+import '../../reminder/models/reminder.dart' show Reminder;
+import '../../services/settings_service.dart';
+import '../models/job_models.dart';
+import 'engine/match_engine.dart';
+import 'engine/teletalk_source.dart';
+import 'radar_models.dart';
+
+/// Job Radar-এর প্রোফাইল, সেটিংস, ক্যাশ ও রূপান্তর। (সবকিছু ফোনের ভেতরে — কোনো সার্ভার/টোকেন লাগে না।)
+class RadarService {
+  // SharedPreferences কী — সবই স্ট্রিং, যাতে ব্যাকআপে সহজে যায়
+  static const kDob = 'radar_dob';
+  static const kEdu = 'radar_edu';
+  static const kSubject = 'radar_subject';
+  static const kTypBn = 'radar_typ_bn';
+  static const kTypEn = 'radar_typ_en';
+  static const kDaily = 'radar_daily_on'; // '1' / '0'
+  static const kReportTime = 'radar_report_time'; // 'HH:mm'
+  static const _kCache = 'radar_cache';
+  static const _kDismissed = 'radar_dismissed';
+
+  /// ব্যাকআপে যাবে এমন কী।
+  static const backupKeys = [kDob, kEdu, kSubject, kTypBn, kTypEn, kDaily, kReportTime];
+
+  static const eduLevels = <String, String>{
+    'ssc': 'এসএসসি / সমমান',
+    'hsc': 'এইচএসসি / সমমান',
+    'degree_pass': 'স্নাতক (পাস কোর্স, ৩ বছর)',
+    'honours': 'স্নাতক (সম্মান)',
+    'masters': 'স্নাতকোত্তর',
+  };
+  static const _eduRank = {'ssc': 2, 'hsc': 3, 'degree_pass': 4, 'honours': 5, 'masters': 6};
+
+  // ── প্রোফাইল ──
+  static String get dob => SettingsService.getString(kDob, defaultValue: '1999-01-01');
+  static String get eduLevel => SettingsService.getString(kEdu, defaultValue: 'degree_pass');
+  static String get subject => SettingsService.getString(kSubject);
+  static int get typingBn => int.tryParse(SettingsService.getString(kTypBn)) ?? 20;
+  static int get typingEn => int.tryParse(SettingsService.getString(kTypEn)) ?? 20;
+
+  // ── রাতের রিপোর্ট ──
+  static bool get dailyOn => SettingsService.getString(kDaily, defaultValue: '1') != '0';
+  static String get reportTime => SettingsService.getString(kReportTime, defaultValue: '21:00');
+  static int get reportHour => int.tryParse(reportTime.split(':').first) ?? 21;
+  static int get reportMinute => int.tryParse(reportTime.split(':').last) ?? 0;
+
+  static const _keywords = [
+    r'কম্পিউটার\s*অপারেটর',
+    r'কম্পিউটার\s*মুদ্রাক্ষরিক',
+    r'ডাটা\s*এন্ট্রি',
+    r'ডেটা\s*এন্ট্রি',
+    r'ডাটা\s*অপারেটর',
+    r'ডেটা\s*অপারেটর',
+    r'অফিস\s*সহায়ক\s*[-–]?\s*কাম',
+    r'computer\s*operator',
+    r'data\s*entry',
+    r'computer\s*typist',
+  ];
+  static const _exclude = ['সাঁট', 'সীট', 'শর্টহ্যান্ড', 'stenograph', 'stenotyp', 'shorthand'];
+  static List<String> get keywords => _keywords;
+
+  /// ইঞ্জিনের জন্য প্রোফাইল অবজেক্ট।
+  static RadarProfile profile() {
+    final p = dob.split('-').map((e) => int.tryParse(e) ?? 0).toList();
+    final d = (p.length == 3 && p[0] > 0) ? DateTime.utc(p[0], p[1], p[2]) : DateTime.utc(1999, 1, 1);
+    return RadarProfile(
+      dob: d,
+      eduRank: _eduRank[eduLevel] ?? 4,
+      eduLabel: eduLevels[eduLevel] ?? eduLevel,
+      subject: subject,
+      typingBn: typingBn,
+      typingEn: typingEn,
+      targetKeywords: _keywords,
+      excludeKeywords: _exclude,
+    );
+  }
+
+  // ── ক্যাশ (শেষ ফলাফল) ──
+  /// ব্যাকগ্রাউন্ড টাস্ক অন্য আইসোলেটে লিখে থাকলে সেটা এখানে দেখার জন্য।
+  static Future<void> reload() async {
+    try {
+      final p = await SharedPreferences.getInstance();
+      await p.reload();
+    } catch (_) {}
+  }
+
+  static RadarFeed? cached() {
+    final raw = SettingsService.getString(_kCache);
+    if (raw.isEmpty) return null;
+    try {
+      return RadarFeed.fromMap(jsonDecode(raw) as Map<String, dynamic>);
+    } catch (_) {
+      return null;
+    }
+  }
+
+  static Future<void> saveFeed(RadarFeed f) => SettingsService.setString(_kCache, jsonEncode(f.toMap()));
+
+  // ── Teletalk-এর পুরো তালিকা (ব্রাউজ ভিউয়ের জন্য) ──
+  static const _kTele = 'radar_teletalk_all';
+
+  static Future<void> saveTeletalkAll(List<TeletalkJob> jobs) =>
+      SettingsService.setString(_kTele, jsonEncode({'at': DateTime.now().millisecondsSinceEpoch, 'jobs': jobs.map((j) => j.toMap()).toList()}));
+
+  static List<TeletalkJob> teletalkAll() {
+    final raw = SettingsService.getString(_kTele);
+    if (raw.isEmpty) return [];
+    try {
+      final m = jsonDecode(raw) as Map<String, dynamic>;
+      return ((m['jobs'] as List?) ?? const [])
+          .map((e) => TeletalkJob.fromCache(Map<String, dynamic>.from(e as Map)))
+          .toList();
+    } catch (_) {
+      return [];
+    }
+  }
+
+  static DateTime? teletalkSavedAt() {
+    final raw = SettingsService.getString(_kTele);
+    if (raw.isEmpty) return null;
+    try {
+      final at = (jsonDecode(raw) as Map)['at'] as num?;
+      return at == null ? null : DateTime.fromMillisecondsSinceEpoch(at.toInt());
+    } catch (_) {
+      return null;
+    }
+  }
+
+  // ── লুকানো (dismissed) ──
+  static Set<String> dismissed() {
+    final raw = SettingsService.getString(_kDismissed);
+    if (raw.isEmpty) return {};
+    try {
+      return (jsonDecode(raw) as List).map((e) => e.toString()).toSet();
+    } catch (_) {
+      return {};
+    }
+  }
+
+  static Future<void> dismiss(String url) async {
+    final list = (dismissed()..add(url)).toList();
+    final keep = list.length > 300 ? list.sublist(list.length - 300) : list;
+    await SettingsService.setString(_kDismissed, jsonEncode(keep));
+  }
+
+  static Future<void> restore(String url) async {
+    final s = dismissed()..remove(url);
+    await SettingsService.setString(_kDismissed, jsonEncode(s.toList()));
+  }
+
+  // ── রূপান্তর ──
+  static const _bnDigits = '০১২৩৪৫৬৭৮৯';
+  static String _toEn(String s) =>
+      s.replaceAllMapped(RegExp('[০-৯]'), (m) => _bnDigits.indexOf(m[0]!).toString());
+
+  static int _feeOf(String s) {
+    final m = RegExp(r'\d+').firstMatch(_toEn(s));
+    return m == null ? 0 : int.tryParse(m[0]!) ?? 0;
+  }
+
+  /// রাডারের সার্কুলার → জব হাবের Circular (নজরে)। সংরক্ষণ করবে JobService.saveCircular।
+  static Circular toCircular(RadarItem it) {
+    final note = StringBuffer(it.verdict == 'ok' ? 'রাডার: সম্ভাব্য যোগ্য' : 'রাডার: যাচাই বাকি');
+    for (final p in it.posts) {
+      for (final c in p.checks) {
+        if (c.s != 'ok') note.write('\n${c.icon} ${p.title}: ${c.msg}');
+      }
+    }
+    if (it.method.isNotEmpty) note.write('\nআবেদন: ${it.method}');
+    note.write('\n(স্বয়ংক্রিয় যাচাই — মূল বিজ্ঞপ্তি দেখে নিশ্চিত হও)');
+    return Circular(
+      title: it.title,
+      org: it.org,
+      post: it.posts.map((p) => p.title).take(3).join(', '),
+      deadline: it.deadline,
+      fee: _feeOf(it.fee),
+      url: it.url,
+      note: note.toString(),
+    );
+  }
+
+  static String ymd(DateTime d) => Reminder.ymd(d);
+}
+
+/// সেটিংস শিট থেকে একসাথে একাধিক স্ট্রিং মান সংরক্ষণ।
+class SettingsPersist {
+  static Future<void> save(Map<String, String> strings) async {
+    for (final e in strings.entries) {
+      await SettingsService.setString(e.key, e.value);
+    }
+  }
+}

diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/engine/bdgovtjob_source.dart b/lib/jobs/radar/engine/bdgovtjob_source.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/engine/bdgovtjob_source.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/engine/bdgovtjob_source.dart	2026-10-21 06:22:30.088210133 +0000
@@ -0,0 +1,94 @@
+import 'dart:convert';
+import 'package:http/http.dart' as http;
+import 'html_text.dart';
+
+const _base = 'https://bdgovtjob.net';
+const _ua = 'JobRadar/1.0 (personal app; once a day)';
+const _blockSlugs = {
+  'category', 'tag', 'author', 'page', 'wp-content', 'wp-json', 'wp-admin', 'feed', 'about', 'contact',
+  'privacy-policy', 'disclaimer', 'terms-conditions', 'editorial-policy', 'smart-search', 'saved-jobs',
+  'age-calculator', 'notice', 'sitemap', 'comments', 'search',
+};
+
+class ListedPost {
+  final String url;
+  final String title;
+  final String? modified;
+  const ListedPost(this.url, this.title, this.modified);
+}
+
+class FetchedDetail {
+  final String title;
+  final String text;
+  const FetchedDetail(this.title, this.text);
+}
+
+Future<String> httpGet(String url, {bool json = false}) async {
+  Object? last;
+  for (var i = 0; i < 2; i++) {
+    try {
+      final res = await http.get(Uri.parse(url), headers: {
+        'user-agent': _ua,
+        'accept': json ? 'application/json' : 'text/html,*/*',
+        'accept-language': 'bn,en;q=0.8',
+      }).timeout(const Duration(seconds: 25));
+      if (res.statusCode != 200) throw Exception('HTTP ${res.statusCode}');
+      return utf8.decode(res.bodyBytes);
+    } catch (e) {
+      last = e;
+      await Future<void>.delayed(Duration(seconds: 2 * (i + 1)));
+    }
+  }
+  throw Exception('$last');
+}
+
+/// সর্বশেষ আপডেট হওয়া পোস্টের তালিকা। আগে WordPress REST, না হলে HTML থেকে লিংক।
+Future<List<ListedPost>> listLatest({int limit = 40}) async {
+  try {
+    final body = await httpGet(
+      '$_base/wp-json/wp/v2/posts?per_page=${limit > 50 ? 50 : limit}&orderby=modified&order=desc&_fields=link,title,modified',
+      json: true,
+    );
+    final arr = jsonDecode(body);
+    if (arr is List && arr.isNotEmpty) {
+      return arr.map<ListedPost>((p) {
+        final m = Map<String, dynamic>.from(p as Map);
+        final t = decodeEntities(((m['title'] as Map?)?['rendered'] ?? '').toString())
+            .replaceAll(RegExp(r'<[^>]+>'), '')
+            .trim();
+        return ListedPost((m['link'] ?? '').toString(), t, m['modified']?.toString());
+      }).where((p) => p.url.isNotEmpty).toList();
+    }
+  } catch (_) {
+    // REST কাজ না করলে নিচের HTML তালিকায় যাব
+  }
+  final seen = <String, ListedPost>{};
+  for (final u in ['$_base/', '$_base/category/government-jobs-circular/', '$_base/category/teletalk-application/']) {
+    try {
+      final html = await httpGet(u);
+      final re = RegExp(r'<a[^>]+href="(https://bdgovtjob\.net/([^"/?#]+)/)"[^>]*>([\s\S]*?)</a>', caseSensitive: false);
+      for (final m in re.allMatches(html)) {
+        final url = m[1]!, slug = m[2]!;
+        if (_blockSlugs.contains(slug) || slug.length < 6) continue;
+        final title = decodeEntities(m[3]!.replaceAll(RegExp(r'<[^>]+>'), '')).replaceAll(RegExp(r'\s+'), ' ').trim();
+        final old = seen[url];
+        if (old == null || title.length > old.title.length) seen[url] = ListedPost(url, title, null);
+      }
+    } catch (_) {}
+  }
+  return seen.values.take(limit).toList();
+}
+
+/// একটি সার্কুলার পেজ → শিরোনাম ও টেক্সট।
+Future<FetchedDetail> fetchDetail(String url) async {
+  final html = await httpGet(url);
+  var body = html;
+  final a = html.indexOf(RegExp(r'<article[\s>]', caseSensitive: false));
+  final b = html.indexOf(RegExp(r'</article>', caseSensitive: false));
+  if (a >= 0 && b > a) body = html.substring(a, b);
+  var text = htmlToText(body);
+  // নিচের "আরও চলমান নিয়োগ / FAQ" অংশ বাদ — ভুল মিল এড়াতে
+  final cut = text.indexOf(RegExp(r'^##\s*(সরকারি চাকরি: আরও|সাধারণ জিজ্ঞাসা|⏳|🆕|📂)', multiLine: true));
+  if (cut > 0) text = text.substring(0, cut);
+  return FetchedDetail(titleOf(html), text);
+}
diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/engine/bn_util.dart b/lib/jobs/radar/engine/bn_util.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/engine/bn_util.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/engine/bn_util.dart	2026-10-20 19:30:07.722632144 +0000
@@ -0,0 +1,65 @@
+// বাংলা অঙ্ক/মাস/তারিখ সহায়ক (ইঞ্জিনের জন্য; সব তারিখ UTC-মধ্যরাত রূপে)।
+const _bn = '০১২৩৪৫৬৭৮৯';
+
+String toEn(String s) => s.replaceAllMapped(RegExp('[০-৯]'), (m) => _bn.indexOf(m[0]!).toString());
+
+String toBnStr(Object? s) =>
+    s.toString().replaceAllMapped(RegExp('[0-9]'), (m) => _bn[int.parse(m[0]!)]);
+
+const monthsMap = <String, int>{
+  'জানুয়ারি': 1, 'জানুয়ারী': 1, 'ফেব্রুয়ারি': 2, 'ফেব্রুয়ারী': 2, 'মার্চ': 3, 'এপ্রিল': 4, 'মে': 5,
+  'জুন': 6, 'জুলাই': 7, 'আগস্ট': 8, 'সেপ্টেম্বর': 9, 'অক্টোবর': 10, 'নভেম্বর': 11, 'ডিসেম্বর': 12,
+  'january': 1, 'february': 2, 'march': 3, 'april': 4, 'may': 5, 'june': 6, 'july': 7,
+  'august': 8, 'september': 9, 'october': 10, 'november': 11, 'december': 12,
+};
+const monthNamesBn = [
+  '', 'জানুয়ারি', 'ফেব্রুয়ারি', 'মার্চ', 'এপ্রিল', 'মে', 'জুন', 'জুলাই', 'আগস্ট', 'সেপ্টেম্বর', 'অক্টোবর', 'নভেম্বর', 'ডিসেম্বর',
+];
+
+final _monthAlt = monthsMap.keys.join('|');
+
+DateTime ymdUtc(int y, int m, int d) => DateTime.utc(y, m, d);
+
+/// ঢাকার সময়ে আজকের তারিখ (UTC-মধ্যরাত)।
+DateTime todayDhaka([DateTime? now]) {
+  final t = (now ?? DateTime.now()).toUtc().add(const Duration(hours: 6));
+  return DateTime.utc(t.year, t.month, t.day);
+}
+
+int daysBetween(DateTime a, DateTime b) => b.difference(a).inDays;
+
+class FoundDate {
+  final DateTime date;
+  final int index;
+  const FoundDate(this.date, this.index);
+}
+
+/// টেক্সট থেকে সব তারিখ (বাংলা/ইংরেজি মাস অথবা dd.mm.yyyy), অবস্থান অনুযায়ী সাজানো।
+List<FoundDate> findDates(String text) {
+  final t = toEn(text);
+  final out = <FoundDate>[];
+  final re1 = RegExp('(\\d{1,2})\\s*($_monthAlt)[,\\s]*(\\d{4})', caseSensitive: false);
+  for (final m in re1.allMatches(t)) {
+    final mo = monthsMap[m[2]!.toLowerCase()] ?? monthsMap[m[2]!];
+    if (mo != null) out.add(FoundDate(ymdUtc(int.parse(m[3]!), mo, int.parse(m[1]!)), m.start));
+  }
+  final re2 = RegExp(r'(\d{1,2})[./-](\d{1,2})[./-](\d{4})');
+  for (final m in re2.allMatches(t)) {
+    final d = int.parse(m[1]!), mo = int.parse(m[2]!);
+    if (mo >= 1 && mo <= 12 && d >= 1 && d <= 31) {
+      out.add(FoundDate(ymdUtc(int.parse(m[3]!), mo, d), m.start));
+    }
+  }
+  out.sort((a, b) => a.index.compareTo(b.index));
+  return out;
+}
+
+String fmtDateBn(DateTime d) => toBnStr('${d.day} ${monthNamesBn[d.month]} ${d.year}');
+
+/// পূর্ণ বছরে বয়স নির্দিষ্ট তারিখে।
+int ageAt(DateTime dob, DateTime ref) {
+  var age = ref.year - dob.year;
+  final m = ref.month - dob.month;
+  if (m < 0 || (m == 0 && ref.day < dob.day)) age--;
+  return age;
+}
diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/engine/circular_parser.dart b/lib/jobs/radar/engine/circular_parser.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/engine/circular_parser.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/engine/circular_parser.dart	2026-10-20 19:30:43.883553420 +0000
@@ -0,0 +1,152 @@
+import 'bn_util.dart';
+
+/// সামারি টেবিলের সারি "লেবেল | মান |" থেকে মান।
+String field(String text, String label) {
+  final re = RegExp('^$label[^|\\n]*\\|\\s*(.+?)\\s*\\|?\\s*\$', multiLine: true);
+  final m = re.firstMatch(text);
+  return m == null ? '' : m[1]!.trim();
+}
+
+class ParsedPost {
+  final String title;
+  final int? count;
+  final String text; // শর্তের লাইনগুলো
+  const ParsedPost(this.title, this.count, this.text);
+}
+
+final _postHead = RegExp(r'^(?:##\s*)?(\d+)\s*[.।)]\s*(.+?)\s*\(\s*(\d+)\s*(?:টি|জন)?\s*পদ\s*\)\s*$');
+final _tableRow = RegExp(r'^(\d+)\s*\|\s*(.+?)\s*\|\s*(\d+)\s*(?:টি|জন)?\s*\|');
+
+/// পদভিত্তিক ব্লক। না পেলে সামারি টেবিল থেকে শুধু নাম।
+List<ParsedPost> parsePosts(String text) {
+  final lines = text.split('\n');
+  final blocks = <_Block>[];
+  _Block? cur;
+  for (final raw in lines) {
+    final l = toEn(raw);
+    final h = _postHead.firstMatch(l);
+    if (h != null) {
+      cur = _Block(h[2]!.replaceAll('*', '').trim(), int.parse(h[3]!));
+      blocks.add(cur);
+      continue;
+    }
+    if (cur != null) {
+      if (RegExp(r'^##\s').hasMatch(l)) {
+        cur = null; // অন্য হেডিং এলে ব্লক শেষ
+      } else {
+        cur.lines.add(raw);
+      }
+    }
+  }
+  if (blocks.isNotEmpty) {
+    return blocks.map((b) => ParsedPost(b.title, b.count, b.lines.join('\n'))).toList();
+  }
+  final rows = <ParsedPost>[];
+  for (final raw in lines) {
+    final m = _tableRow.firstMatch(toEn(raw));
+    if (m != null) rows.add(ParsedPost(m[2]!.trim(), int.parse(m[3]!), ''));
+  }
+  return rows;
+}
+
+class _Block {
+  final String title;
+  final int count;
+  final List<String> lines = [];
+  _Block(this.title, this.count);
+}
+
+class Typing {
+  final int? bn;
+  final int? en;
+  const Typing(this.bn, this.en);
+}
+
+/// টাইপিং শর্ত (WPM)। ভাষা আলাদা না থাকলে দুটোতেই একই ধরা হয়।
+Typing parseTyping(String rawText) {
+  final t = toEn(rawText);
+  int? num(RegExp re) {
+    final m = re.firstMatch(t);
+    return m == null ? null : int.parse(m[1]!);
+  }
+
+  const tail = r'\s*(?:শব্দ|wpm|ওয়ার্ড|ও(?=\s|$)|এবং|,)';
+  var bn = num(RegExp(r'বাংলা(?:য়|তে|র)?[^0-9।]{0,14}?(\d+)' + tail, caseSensitive: false));
+  var en = num(RegExp(r'ইংরেজি(?:তে|র)?[^0-9।]{0,14}?(\d+)' + tail, caseSensitive: false));
+  if (bn == null && en == null) {
+    final g = num(RegExp(r'প্রতি\s*মিনিটে[^0-9।]{0,30}?(\d+)\s*(?:শব্দ|wpm)', caseSensitive: false));
+    if (g != null) {
+      bn = g;
+      en = g;
+    }
+  }
+  return Typing(bn, en);
+}
+
+class AgeInfo {
+  final int? min;
+  final int max;
+  final DateTime? refDate;
+  const AgeInfo(this.min, this.max, this.refDate);
+}
+
+/// বয়সসীমা: ন্যূনতম/সর্বোচ্চ ও গণনার তারিখ।
+AgeInfo? parseAge(String rawText, DateTime? fallbackRef) {
+  final t = toEn(rawText);
+  int? min;
+  int? max;
+  var idx = -1;
+  final r1 = RegExp(r'(\d{1,2})\s*(?:থেকে|[-–])\s*(?:অনুর্ধ্ব|অনূর্ধ্ব|সর্বোচ্চ)?\s*(\d{1,2})\s*বছর');
+  final r2 = RegExp(r'(?:অনুর্ধ্ব|অনূর্ধ্ব|সর্বোচ্চ)\s*(\d{1,2})\s*বছর');
+  final m1 = r1.firstMatch(t);
+  if (m1 != null) {
+    min = int.parse(m1[1]!);
+    max = int.parse(m1[2]!);
+    idx = m1.start;
+  } else {
+    final m2 = r2.firstMatch(t);
+    if (m2 != null) {
+      max = int.parse(m2[1]!);
+      idx = m2.start;
+    }
+  }
+  if (max == null) return null;
+  var ref = fallbackRef;
+  final from = (idx - 90) < 0 ? 0 : idx - 90;
+  final to = (idx + 5) > t.length ? t.length : idx + 5;
+  final before = t.substring(from, to);
+  final ds = findDates(before);
+  if (ds.isNotEmpty && before.contains('তারিখে')) ref = ds.last.date;
+  return AgeInfo(min, max, ref);
+}
+
+class EduInfo {
+  final int? required; // 2=SSC 3=HSC 4=স্নাতক(পাস) 5=অনার্স 6=মাস্টার্স
+  final List<String> flags;
+  const EduInfo(this.required, this.flags);
+}
+
+EduInfo parseEducation(String rawText) {
+  var t = rawText;
+  final levels = <int>[];
+  final flags = <String>[];
+  if (RegExp(r'স্নাতকোত্তর|মাস্টার', caseSensitive: false).hasMatch(t)) levels.add(6);
+  t = t.replaceAll(RegExp(r'স্নাতকোত্তর|মাস্টার[স্সz]*', caseSensitive: false), ' ');
+  final hon = RegExp(r'স্নাতক\s*\(?\s*সম্মান\s*\)?|সম্মান\s*সহ|অনার্স|honou?rs|চার\s*বছর\s*মেয়াদী', caseSensitive: false);
+  final hasHon = hon.hasMatch(t);
+  if (hasHon) levels.add(5);
+  t = t.replaceAll(hon, ' ');
+  final bpass = RegExp(r'স্নাতক\s*\(?\s*পাস\s*\)?|স্নাতক\s*পাস|ডিগ্রি\s*পাস', caseSensitive: false);
+  if (bpass.hasMatch(t)) levels.add(4);
+  t = t.replaceAll(bpass, ' ');
+  if (RegExp(r'স্নাতক|bachelor', caseSensitive: false).hasMatch(t)) levels.add(4);
+  if (RegExp(r'এইচ\s*এস\s*সি|উচ্চ\s*মাধ্যমিক|\bhsc\b|ইন্টারমিডিয়েট|আলিম', caseSensitive: false).hasMatch(t)) levels.add(3);
+  t = t.replaceAll(RegExp(r'উচ্চ\s*মাধ্যমিক'), ' ');
+  if (RegExp(r'এস\s*এস\s*সি|মাধ্যমিক|\bssc\b|দাখিল', caseSensitive: false).hasMatch(t)) levels.add(2);
+  // শুধু "ডিগ্রি" লেখা থাকলে (স্নাতক শব্দ ছাড়া) সেটাকেও স্নাতক ধরি
+  if (levels.isEmpty && t.contains('ডিগ্রি') && !t.contains('ডিপ্লোমা')) levels.add(4);
+  if (rawText.contains('ডিপ্লোমা')) flags.add('diploma');
+  int? required;
+  if (levels.isNotEmpty) required = levels.reduce((a, b) => a < b ? a : b);
+  return EduInfo(required, flags);
+}
diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/engine/html_text.dart b/lib/jobs/radar/engine/html_text.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/engine/html_text.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/engine/html_text.dart	2026-10-20 19:30:07.723513893 +0000
@@ -0,0 +1,39 @@
+const _ent = {
+  'amp': '&', 'lt': '<', 'gt': '>', 'quot': '"', 'apos': "'", 'nbsp': ' ', 'ndash': '–', 'mdash': '—', 'hellip': '…',
+};
+
+String decodeEntities(String s) {
+  return s
+      .replaceAllMapped(RegExp(r'&#(\d+);'), (m) => String.fromCharCode(int.parse(m[1]!)))
+      .replaceAllMapped(RegExp(r'&#x([0-9a-fA-F]+);'), (m) => String.fromCharCode(int.parse(m[1]!, radix: 16)))
+      .replaceAllMapped(RegExp(r'&([a-zA-Z]+);'), (m) => _ent[m[1]!.toLowerCase()] ?? m[0]!);
+}
+
+/// HTML → লাইনভিত্তিক টেক্সট। হেডিং হয় "## ..." লাইন, টেবিলের ঘর "|" দিয়ে আলাদা।
+String htmlToText(String html) {
+  var s = html
+      .replaceAll(RegExp(r'<(script|style|noscript|svg|template)[\s\S]*?</\1>', caseSensitive: false), '')
+      .replaceAll(RegExp(r'<!--[\s\S]*?-->'), '')
+      .replaceAll(RegExp(r'<h[1-6][^>]*>', caseSensitive: false), '\n## ')
+      .replaceAll(
+          RegExp(r'</(h[1-6]|p|div|li|tr|table|section|ul|ol|article|header|footer|blockquote)>', caseSensitive: false),
+          '\n')
+      .replaceAll(RegExp(r'<(br|hr)\s*/?>', caseSensitive: false), '\n')
+      .replaceAll(RegExp(r'</t[dh]>', caseSensitive: false), ' | ')
+      .replaceAll(RegExp(r'<li[^>]*>', caseSensitive: false), '\n')
+      .replaceAll(RegExp(r'<[^>]+>'), '');
+  s = decodeEntities(s);
+  final ws = RegExp('[\\s\u00a0\u200b]+');
+  return s
+      .split('\n')
+      .map((l) => l.replaceAll(ws, ' ').trim())
+      .where((l) => l.isNotEmpty)
+      .join('\n');
+}
+
+String titleOf(String html) {
+  final m = RegExp(r'<h1[^>]*>([\s\S]*?)</h1>', caseSensitive: false).firstMatch(html) ??
+      RegExp(r'<title[^>]*>([\s\S]*?)</title>', caseSensitive: false).firstMatch(html);
+  if (m == null) return '';
+  return decodeEntities(m[1]!.replaceAll(RegExp(r'<[^>]+>'), '')).replaceAll(RegExp(r'\s+'), ' ').trim();
+}
diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/engine/match_engine.dart b/lib/jobs/radar/engine/match_engine.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/engine/match_engine.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/engine/match_engine.dart	2026-10-21 08:50:24.485712805 +0000
@@ -0,0 +1,211 @@
+import '../radar_models.dart';
+import 'bn_util.dart';
+import 'circular_parser.dart';
+
+/// রাডারের জন্য ব্যবহারকারীর প্রোফাইল।
+class RadarProfile {
+  final DateTime dob; // UTC-মধ্যরাত
+  final int eduRank; // 2..6
+  final String eduLabel;
+  final String subject;
+  final int typingBn;
+  final int typingEn;
+  final List<String> targetKeywords;
+  final List<String> excludeKeywords;
+  const RadarProfile({
+    required this.dob,
+    required this.eduRank,
+    required this.eduLabel,
+    this.subject = '',
+    required this.typingBn,
+    required this.typingEn,
+    required this.targetKeywords,
+    required this.excludeKeywords,
+  });
+}
+
+class EvalResult {
+  final bool expired;
+  final List<DateTime> deadlines;
+  final DateTime? nearest;
+  final String org;
+  final String method;
+  final String fee;
+  final List<RadarPost> posts; // শুধু টার্গেট পদগুলো
+  final String verdict; // ok | warn | fail | none
+  const EvalResult({
+    required this.expired,
+    required this.deadlines,
+    required this.nearest,
+    required this.org,
+    required this.method,
+    required this.fee,
+    required this.posts,
+    required this.verdict,
+  });
+}
+
+const _eduLabel = {
+  2: 'এসএসসি',
+  3: 'এইচএসসি',
+  4: 'স্নাতক (পাস)',
+  5: 'স্নাতক (সম্মান/অনার্স)',
+  6: 'স্নাতকোত্তর',
+};
+
+bool _any(List<String> pats, String s) => pats.any((k) => RegExp(k, caseSensitive: false).hasMatch(s));
+
+/// 'yes' | 'shorthand' | 'no'
+String postRelevance(String title, RadarProfile p) {
+  if (!_any(p.targetKeywords, title)) return 'no';
+  if (_any(p.excludeKeywords, title)) return 'shorthand';
+  return 'yes';
+}
+
+List<DateTime> parseDeadlines(String text) {
+  final f = field(text, 'আবেদনের শেষ তারিখ');
+  var ds = f.isNotEmpty ? findDates(f) : <FoundDate>[];
+  if (ds.isEmpty) {
+    final m = RegExp(r'আবেদনের\s*শেষ\s*(?:তারিখ|সময়)[^\n]{0,80}').firstMatch(text);
+    if (m != null) ds = findDates(m[0]!);
+  }
+  return ds.map((d) => d.date).toList();
+}
+
+RadarCheck _ok(String k, String m) => RadarCheck(key: k, s: 'ok', msg: m);
+RadarCheck _warn(String k, String m) => RadarCheck(key: k, s: 'warn', msg: m);
+RadarCheck _fail(String k, String m) => RadarCheck(key: k, s: 'fail', msg: m);
+
+/// "সাপ্তাহিক চাকরির খবর" ধরনের সংকলন/পত্রিকা-পোস্ট — আসল সার্কুলার নয়।
+final _roundup = RegExp(r'চাকরির\s*খবর|চাকরির\s*ডাক|সাপ্তাহিক|দৈনিক\s*পত্রিকা|পত্রিকা\s*(?:থেকে|সহ)|newspaper|chakrir\s*khobor|saptahik', caseSensitive: false);
+
+/// একটি সার্কুলারের টেক্সট যাচাই। (JS ইঞ্জিনের হুবহু অনুবাদ — একই টেস্টে যাচাই করা)
+EvalResult evaluate(String text, RadarProfile profile, {String? title, DateTime? now}) {
+  final today = todayDhaka(now);
+  if (title != null && _roundup.hasMatch(title)) {
+    return const EvalResult(
+        expired: false, deadlines: [], nearest: null, org: '', method: '', fee: '', posts: [], verdict: 'none');
+  }
+  final expiredBanner = RegExp(r'আবেদনের\s*সময়\s*শেষ\s*হয়েছে').hasMatch(text);
+  final deadlines = parseDeadlines(text);
+  final upcoming = deadlines.where((d) => daysBetween(today, d) >= 0).toList()..sort();
+  final nearest = upcoming.isEmpty ? null : upcoming.first;
+  final lastDeadline = deadlines.isEmpty ? null : deadlines.last;
+  final expired = expiredBanner || (deadlines.isNotEmpty && upcoming.isEmpty);
+
+  final summaryEdu = field(text, 'শিক্ষাগত যোগ্যতা');
+  final method = field(text, 'আবেদন পদ্ধতি');
+  final fee = field(text, 'আবেদনের ফি');
+  final org = field(text, 'প্রতিষ্ঠানের নাম');
+
+  // বয়স — পুরো সার্কুলারের জন্য
+  final ageInfo = parseAge(text, lastDeadline);
+  RadarCheck ageCheck;
+  if (ageInfo == null) {
+    ageCheck = _warn('age', 'বয়সসীমা খুঁজে পাইনি — বিজ্ঞপ্তিতে দেখো');
+  } else {
+    final ref = ageInfo.refDate ?? lastDeadline ?? today;
+    final age = ageAt(profile.dob, ref);
+    final refTxt = fmtDateBn(ref);
+    if (age > ageInfo.max) {
+      ageCheck = _fail('age', 'বয়স বেশি: ${toBnStr(age)} বছর (সীমা ${toBnStr(ageInfo.max)}, $refTxt-এর হিসাবে)');
+    } else if (ageInfo.min != null && age < ageInfo.min!) {
+      ageCheck = _fail('age', 'বয়স কম: ${toBnStr(age)} (ন্যূনতম ${toBnStr(ageInfo.min)})');
+    } else {
+      ageCheck = _ok('age', 'বয়স ${toBnStr(age)} ≤ ${toBnStr(ageInfo.max)} ($refTxt-এর হিসাবে)');
+    }
+  }
+
+  var posts = parsePosts(text);
+  if (posts.isEmpty && title != null && title.isNotEmpty && postRelevance(title, profile) != 'no') {
+    posts = [ParsedPost(title, null, '')];
+  }
+
+  final evaluated = <RadarPost>[];
+  for (final p in posts) {
+    final rel = postRelevance(p.title, profile);
+    if (rel == 'no') continue;
+    final checks = <RadarCheck>[ageCheck];
+
+    if (rel == 'shorthand') {
+      evaluated.add(RadarPost(
+          title: p.title, count: p.count, verdict: 'fail', checks: [_fail('post', 'সাঁটলিপি/শর্টহ্যান্ড লাগে')]));
+      continue;
+    }
+
+    final eduText = p.text.trim().isNotEmpty ? p.text : summaryEdu;
+    final edu = parseEducation(eduText);
+    if (edu.required == null) {
+      checks.add(_warn('edu', 'শিক্ষাগত যোগ্যতা পরিষ্কার না — বিজ্ঞপ্তিতে দেখো'));
+    } else if (edu.required! > profile.eduRank) {
+      checks.add(_fail('edu', '${_eduLabel[edu.required]} চায় — তোমার ${profile.eduLabel}'));
+    } else {
+      checks.add(_ok('edu', '${_eduLabel[edu.required]} চায় — তোমার ${profile.eduLabel}'));
+      if (edu.required! >= 4 &&
+          RegExp(r'(বিভাগে|বিষয়ে|সংশ্লিষ্ট\s*বিষয়)').hasMatch(eduText) &&
+          profile.subject.isEmpty) {
+        checks.add(_warn('subject', 'নির্দিষ্ট বিষয়/বিভাগের শর্ত থাকতে পারে — মিলিয়ে নাও'));
+      }
+    }
+    if (edu.flags.contains('diploma') && edu.required == null) checks.add(_fail('edu', 'ডিপ্লোমা শর্ত আছে'));
+    final cls = RegExp(r'(২য়|দ্বিতীয়|১ম|প্রথম)\s*(শ্রেণি|বিভাগ)|সিজিপিএ|CGPA|GPA', caseSensitive: false).firstMatch(eduText);
+    if (cls != null) checks.add(_warn('result', 'ফলাফলের শর্ত: "${cls[0]}" — নিজের ফল মিলিয়ে নাও'));
+
+    final typingText = p.text.trim().isNotEmpty ? p.text : text;
+    final ty = parseTyping(typingText);
+    if (ty.bn == null && ty.en == null) {
+      checks.add(_warn('typing', 'টাইপিং গতির উল্লেখ পাইনি'));
+    } else {
+      final gaps = <String>[];
+      if (ty.bn != null && ty.bn! > profile.typingBn) gaps.add('বাংলা ${toBnStr(ty.bn)} (তোমার ${toBnStr(profile.typingBn)})');
+      if (ty.en != null && ty.en! > profile.typingEn) gaps.add('ইংরেজি ${toBnStr(ty.en)} (তোমার ${toBnStr(profile.typingEn)})');
+      final need = [
+        if (ty.bn != null) 'বাংলা ${toBnStr(ty.bn)}',
+        if (ty.en != null) 'ইংরেজি ${toBnStr(ty.en)}',
+      ].join(', ');
+      checks.add(gaps.isNotEmpty
+          ? _warn('typing', 'টাইপিং বাড়াতে হবে — ${gaps.join(', ')}')
+          : _ok('typing', 'টাইপিং $need WPM — তোমার গতিতে মেলে'));
+    }
+
+    final blk = p.text;
+    if (RegExp(r'কম্পিউটার[^।\n]{0,60}(সনদ|প্রশিক্ষণ|কোর্স|সার্টিফিকেট|ডিপ্লোমা)').hasMatch(blk)) {
+      checks.add(_warn('cert', 'কম্পিউটার সনদ/প্রশিক্ষণের শর্ত আছে'));
+    }
+    if (RegExp(r'(\d+)\s*বছর(?:ের)?\s*(?:কাজের\s*)?অভিজ্ঞতা|অভিজ্ঞতা[^।\n]{0,20}(\d+)\s*বছর').hasMatch(toEn(blk))) {
+      checks.add(_warn('exp', 'অভিজ্ঞতার শর্ত আছে'));
+    }
+
+    final verdict = checks.any((c) => c.s == 'fail') ? 'fail' : (checks.any((c) => c.s == 'warn') ? 'warn' : 'ok');
+    evaluated.add(RadarPost(title: p.title, count: p.count, verdict: verdict, checks: checks));
+  }
+
+  // নিরাপত্তা-জাল: পদ আলাদা করা না গেলেও পেজে টার্গেট শব্দ থাকলে "যাচাই বাকি" — যেন কিছু মিস না হয়।
+  if (evaluated.isEmpty && _any(profile.targetKeywords, text)) {
+    evaluated.add(RadarPost(
+      title: (title == null || title.isEmpty) ? 'সার্কুলার' : title,
+      verdict: 'warn',
+      checks: [
+        ageCheck,
+        _warn('parse', 'পেজে কম্পিউটার অপারেটর/ডাটা এন্ট্রি-জাতীয় শব্দ আছে, কিন্তু পদভিত্তিক শর্ত আলাদা করতে পারিনি — মূল বিজ্ঞপ্তি দেখো'),
+      ],
+    ));
+  }
+
+  const rank = {'ok': 0, 'warn': 1, 'fail': 2};
+  var verdict = 'none';
+  if (evaluated.isNotEmpty) {
+    verdict = evaluated.map((e) => e.verdict).reduce((a, b) => rank[a]! <= rank[b]! ? a : b);
+  }
+
+  return EvalResult(
+    expired: expired,
+    deadlines: deadlines,
+    nearest: nearest,
+    org: org,
+    method: method,
+    fee: fee,
+    posts: evaluated,
+    verdict: verdict,
+  );
+}
diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/engine/teletalk_radar.dart b/lib/jobs/radar/engine/teletalk_radar.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/engine/teletalk_radar.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/engine/teletalk_radar.dart	2026-10-21 09:03:10.293834948 +0000
@@ -0,0 +1,99 @@
+import '../radar_models.dart';
+import 'bn_util.dart';
+import 'match_engine.dart';
+import 'teletalk_source.dart';
+
+/// তালিকা থেকে আমাদের টার্গেট পদগুলো (মেয়াদ বাকি, সাঁটলিপি নয়)।
+List<TeletalkJob> pickTeletalkTargets(List<TeletalkJob> jobs, RadarProfile profile, {DateTime? now}) {
+  final today = todayDhaka(now);
+  return jobs.where((j) {
+    if (j.deadline != null && daysBetween(today, j.deadline!) < 0) return false;
+    return postRelevance('${j.titleBn} ${j.titleEn}', profile) == 'yes';
+  }).toList();
+}
+
+/// বিস্তারিত API-র বয়সসীমা দিয়ে বয়স যাচাই। রেফারেন্স তারিখ = শেষ তারিখ (মূল বিজ্ঞপ্তিতে গণনার তারিখ দেখে নিও)।
+RadarCheck? teletalkAgeCheck(TeletalkJob j, TeletalkDetail? d, RadarProfile profile) {
+  if (d == null || d.maxAge == null) return null;
+  final ref = j.deadline ?? todayDhaka();
+  final age = ageAt(profile.dob, ref);
+  final refTxt = fmtDateBn(ref);
+  if (age > d.maxAge!) {
+    return RadarCheck(key: 'age', s: 'fail', msg: 'বয়স বেশি: ${toBnStr(age)} বছর (সীমা ${toBnStr(d.maxAge)}, $refTxt-এর হিসাবে)');
+  }
+  if (d.minAge != null && age < d.minAge!) {
+    return RadarCheck(key: 'age', s: 'fail', msg: 'বয়স কম: ${toBnStr(age)} (ন্যূনতম ${toBnStr(d.minAge)})');
+  }
+  return RadarCheck(key: 'age', s: 'ok', msg: 'বয়স ${toBnStr(age)} ≤ ${toBnStr(d.maxAge)} ($refTxt-এর হিসাবে — মূল বিজ্ঞপ্তিতে গণনার তারিখ দেখো)');
+}
+
+/// টার্গেট পদগুলো বেছে একই প্রতিষ্ঠানের পদ একসাথে করে RadarItem বানায়।
+///
+/// [details] থাকলে বয়স স্বয়ংক্রিয় যাচাই হয় (বয়সে না মিললে পদটা বাদ)। শিক্ষা ও টাইপিংয়ের শর্ত শুধু
+/// বিজ্ঞপ্তির PDF-এ থাকে, তাই কার্ড সবসময় "যাচাই বাকি" (🟡) — PDF দেখে নিশ্চিত হতে হবে।
+List<RadarItem> teletalkItems(
+  List<TeletalkJob> jobs,
+  RadarProfile profile, {
+  DateTime? now,
+  Map<int, TeletalkDetail> details = const {},
+}) {
+  final today = todayDhaka(now);
+  final groups = <String, List<TeletalkJob>>{};
+  for (final j in pickTeletalkTargets(jobs, profile, now: now)) {
+    final key = j.applyUrl.isNotEmpty ? j.applyUrl : j.shortName;
+    groups.putIfAbsent(key, () => []).add(j);
+  }
+
+  final items = <RadarItem>[];
+  groups.forEach((key, list) {
+    list.sort((a, b) => a.primaryId.compareTo(b.primaryId));
+    final first = list.first;
+    final org = first.orgNameBn.isNotEmpty ? first.orgNameBn : first.orgName;
+
+    final posts = <RadarPost>[];
+    final usable = <TeletalkJob>[];
+    for (final j in list) {
+      final d = details[j.primaryId];
+      final age = teletalkAgeCheck(j, d, profile);
+      if (age != null && age.s == 'fail') continue; // বয়সে মেলেনি — কার্ডে আনি না
+
+      final checks = <RadarCheck>[
+        RadarCheck(key: 'post', s: 'ok', msg: 'পদের নাম মিলেছে: ${j.titleEn}'),
+        if (age != null) age else const RadarCheck(key: 'age', s: 'warn', msg: 'বয়সসীমা আনা যায়নি — বিজ্ঞপ্তিতে দেখো'),
+      ];
+      if (j.published != null && daysBetween(today, j.published!) > 0) {
+        checks.add(RadarCheck(key: 'start', s: 'warn', msg: 'আবেদন শুরু: ${fmtDateBn(j.published!)} (এখনো শুরু হয়নি)'));
+      }
+      checks.add(const RadarCheck(
+        key: 'details',
+        s: 'warn',
+        msg: 'শিক্ষা ও টাইপিংয়ের শর্ত বিজ্ঞপ্তির PDF-এ দেখো — এখনো স্বয়ংক্রিয় যাচাই হয়নি',
+      ));
+      if (d != null && d.adNo.isNotEmpty) {
+        checks.add(RadarCheck(key: 'adno', s: 'ok', msg: 'বিজ্ঞপ্তি নং: ${d.adNo}'));
+      }
+      posts.add(RadarPost(
+        title: j.titleBn.isNotEmpty ? j.titleBn : j.titleEn,
+        count: j.vacancy,
+        verdict: 'warn',
+        checks: checks,
+      ));
+      usable.add(j);
+    }
+    if (posts.isEmpty) return;
+
+    final deadlines = usable.map((j) => j.deadline).whereType<DateTime>().toList()..sort();
+    final dl = deadlines.isEmpty ? null : deadlines.first;
+    items.add(RadarItem(
+      // Teletalk-এ এই প্রতিষ্ঠানের বিস্তারিত পেজ; #teletalk যোগ করে bdgovtjob-এর লিংকের সাথে মিশে যাওয়া ঠেকানো
+      url: '${first.detailsUrl}#teletalk',
+      title: '$org (Teletalk)',
+      verdict: 'warn',
+      org: org,
+      deadline: dl == null ? null : DateTime(dl.year, dl.month, dl.day),
+      method: 'অনলাইন — ${first.applyUrl}',
+      posts: posts,
+    ));
+  });
+  return items;
+}
diff -ruN orig/my-manager-flutter-main/lib/jobs/radar/engine/teletalk_source.dart b/lib/jobs/radar/engine/teletalk_source.dart
--- orig/my-manager-flutter-main/lib/jobs/radar/engine/teletalk_source.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/jobs/radar/engine/teletalk_source.dart	2026-10-21 09:03:10.290415445 +0000
@@ -0,0 +1,154 @@
+import 'dart:convert';
+import 'package:http/http.dart' as http;
+import 'bdgovtjob_source.dart' show httpGet;
+
+const _site = 'https://alljobs.teletalk.com.bd';
+const _api = '$_site/api/v1/published-jobs/search';
+
+/// Teletalk AllJobs-এর সরকারি চাকরির এন্ট্রি (খোলা JSON API থেকে)।
+class TeletalkJob {
+  final int primaryId; // 15024 — বিস্তারিত API-র আইডি
+  final int? orgId; // 1165
+  final String jobId; // GJOB15024
+  final String titleEn;
+  final String titleBn;
+  final int? vacancy;
+  final String applyUrl;
+  final DateTime? published; // আবেদন শুরু (বাংলাদেশ সময়ের তারিখ, UTC-মধ্যরাত)
+  final DateTime? deadline; // শেষ তারিখ (বাংলাদেশ সময়ের তারিখ, UTC-মধ্যরাত)
+  final String orgName;
+  final String orgNameBn;
+  final String shortName;
+
+  const TeletalkJob({
+    this.primaryId = 0,
+    this.orgId,
+    required this.jobId,
+    required this.titleEn,
+    required this.titleBn,
+    this.vacancy,
+    required this.applyUrl,
+    this.published,
+    this.deadline,
+    required this.orgName,
+    required this.orgNameBn,
+    required this.shortName,
+  });
+
+  static String? _ymd(DateTime? d) =>
+      d == null ? null : '${d.year.toString().padLeft(4, '0')}-${d.month.toString().padLeft(2, '0')}-${d.day.toString().padLeft(2, '0')}';
+
+  static DateTime? _fromYmd(Object? s) {
+    final p = (s ?? '').toString().split('-');
+    if (p.length != 3) return null;
+    final y = int.tryParse(p[0]), m = int.tryParse(p[1]), d = int.tryParse(p[2]);
+    return (y == null || m == null || d == null) ? null : DateTime.utc(y, m, d);
+  }
+
+  /// ক্যাশে রাখার সংক্ষিপ্ত রূপ।
+  /// Teletalk সাইটে এই চাকরির বিস্তারিত পেজ।
+  String get detailsUrl => orgId == null || primaryId == 0
+      ? '$_site/jobs?orgid=1'
+      : '$_site/jobs/government/$orgId?jobId=$primaryId';
+
+  Map<String, dynamic> toMap() => {
+        'pid': primaryId, 'oid': orgId,
+        'id': jobId, 'en': titleEn, 'bn': titleBn, 'vac': vacancy, 'url': applyUrl,
+        'pub': _ymd(published), 'dl': _ymd(deadline), 'org': orgName, 'orgBn': orgNameBn, 'short': shortName,
+      };
+
+  factory TeletalkJob.fromCache(Map<String, dynamic> m) => TeletalkJob(
+        primaryId: (m['pid'] as num?)?.toInt() ?? 0,
+        orgId: (m['oid'] as num?)?.toInt(),
+        jobId: (m['id'] ?? '').toString(),
+        titleEn: (m['en'] ?? '').toString(),
+        titleBn: (m['bn'] ?? '').toString(),
+        vacancy: (m['vac'] as num?)?.toInt(),
+        applyUrl: (m['url'] ?? '').toString(),
+        published: _fromYmd(m['pub']),
+        deadline: _fromYmd(m['dl']),
+        orgName: (m['org'] ?? '').toString(),
+        orgNameBn: (m['orgBn'] ?? '').toString(),
+        shortName: (m['short'] ?? '').toString(),
+      );
+
+  /// "2026-11-14T10:00:00.000Z" → বাংলাদেশ সময়ের তারিখ (UTC-মধ্যরাত রূপে)।
+  static DateTime? _bdDate(Object? iso) {
+    final d = DateTime.tryParse((iso ?? '').toString());
+    if (d == null) return null;
+    final t = d.toUtc().add(const Duration(hours: 6));
+    return DateTime.utc(t.year, t.month, t.day);
+  }
+
+  factory TeletalkJob.fromMap(Map<String, dynamic> m) => TeletalkJob(
+        primaryId: (m['job_primary_id'] as num?)?.toInt() ?? 0,
+        orgId: (m['organization_id'] as num?)?.toInt(),
+        jobId: (m['job_id'] ?? '').toString(),
+        titleEn: (m['job_title'] ?? '').toString().trim(),
+        titleBn: (m['job_title_bn'] ?? '').toString().trim(),
+        vacancy: int.tryParse((m['vacancy'] ?? '').toString()),
+        applyUrl: (m['application_site_url'] ?? '').toString().trim(),
+        published: _bdDate(m['published_date']),
+        deadline: _bdDate(m['deadline_date']),
+        orgName: (m['org_name'] ?? '').toString().trim(),
+        orgNameBn: (m['org_name_bn'] ?? '').toString().trim(),
+        shortName: (m['short_name'] ?? '').toString().trim(),
+      );
+}
+
+/// সব চলমান সরকারি চাকরি (পেজ ধরে ধরে; ২০টা করে — যে মান যাচাই করা হয়েছে)। দিনে একবার চলে।
+Future<List<TeletalkJob>> fetchTeletalkJobs({int maxPages = 15}) async {
+  final out = <TeletalkJob>[];
+  var total = 0;
+  for (var page = 1; page <= maxPages; page++) {
+    final body = await httpGet('$_api?page=$page&limit=20&org=1', json: true);
+    final m = Map<String, dynamic>.from(jsonDecode(body) as Map);
+    total = (m['count'] as num?)?.toInt() ?? total;
+    final list = (m['govtJobs'] as List?) ?? const [];
+    if (list.isEmpty) break;
+    for (final e in list) {
+      out.add(TeletalkJob.fromMap(Map<String, dynamic>.from(e as Map)));
+    }
+    if (total > 0 && out.length >= total) break;
+    await Future<void>.delayed(const Duration(milliseconds: 500));
+  }
+  return out;
+}
+
+/// বিস্তারিত API থেকে পাওয়া শর্ত: বয়স, বিজ্ঞপ্তি নং, বিজ্ঞপ্তির PDF-এর পাথ।
+class TeletalkDetail {
+  final int? minAge;
+  final int? maxAge;
+  final String adNo;
+  final String adFile; // "public/uploads/governments/jobs/advertisement-….pdf"
+  const TeletalkDetail({this.minAge, this.maxAge, this.adNo = '', this.adFile = ''});
+
+  factory TeletalkDetail.fromMap(Map<String, dynamic> m) => TeletalkDetail(
+        minAge: (m['min_age'] as num?)?.toInt(),
+        maxAge: (m['max_age'] as num?)?.toInt(),
+        adNo: (m['advertisement_no'] ?? '').toString().trim(),
+        adFile: (m['advertisement_file'] ?? '').toString().trim(),
+      );
+}
+
+Future<TeletalkDetail> fetchTeletalkDetail(int primaryId) async {
+  final body = await httpGet('$_site/api/v1/govt-jobs/public-details?id=$primaryId', json: true);
+  final m = Map<String, dynamic>.from(jsonDecode(body) as Map);
+  return TeletalkDetail.fromMap(Map<String, dynamic>.from((m['details'] as Map?) ?? {}));
+}
+
+/// বিজ্ঞপ্তির PDF-এর আসল লিংক খুঁজে বের করে (পাথ থেকে সম্ভাব্য ঠিকানা পরীক্ষা করে; পাওয়া না গেলে null)।
+Future<String?> resolveAdvertisementUrl(String path) async {
+  if (path.isEmpty) return null;
+  final p = path.replaceFirst(RegExp(r'^/+'), '');
+  final candidates = <String>{'$_site/$p', '$_site/${p.replaceFirst(RegExp(r'^public/'), '')}'};
+  for (final u in candidates) {
+    try {
+      final r = await http.head(Uri.parse(u)).timeout(const Duration(seconds: 8));
+      final ct = (r.headers['content-type'] ?? '').toLowerCase();
+      // সাইট অজানা পাথে 200 + HTML ফেরত দিতে পারে, তাই কনটেন্ট-টাইপ দেখি
+      if (r.statusCode == 200 && (ct.contains('pdf') || ct.contains('octet-stream'))) return u;
+    } catch (_) {}
+  }
+  return null;
+}
